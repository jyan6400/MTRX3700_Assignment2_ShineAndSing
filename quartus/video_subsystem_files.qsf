# Video subsystem (Advay) -- lines for assignment2.qsf (Jason maintains the .qsf; paste these in).
# Paths are relative to quartus/, as in the Mini-Project 2 barcode project.

# ---- RTL ----
# shared (already in assignment2.qsf): the frozen constants must come before every file that uses them
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/common/assignment2_pkg.sv
set_global_assignment -name VERILOG_FILE ../rtl/common/synchroniser.v
# reused, unchanged
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/lesson3_reuse/video_pll.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/barcode_reuse/image_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/barcode_reuse/raster_source.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/barcode_reuse/conv3x3.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/barcode_reuse/sobel.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/barcode_reuse/col_profile.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/barcode_reuse/peak_pick.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/barcode_reuse/cdc_latch.sv
# new for A2: the five planned modules and the integrated video path
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/a2/profile_normalise.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/a2/hysteresis_profile.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/a2/local_threshold.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/a2/key_mask_generator.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/a2/game_video_overlay.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/video/a2/video_subsystem.sv
# (rtl/video/lesson3_reuse/vga_face.sv is kept for reference only: do NOT add it)

# ---- the VGA Controller (Platform Designer; Avalon-ST sink exported) ----
set_global_assignment -name QSYS_FILE vga_sink.qsys

# ---- the three pictures (a missing .mif is a black picture and only a warning: build_on_vm.sh-style check
#      for Critical Warning 127003 is worth keeping) ----
set_global_assignment -name MIF_FILE ../memory/piano0.mif
set_global_assignment -name MIF_FILE ../memory/piano1.mif
set_global_assignment -name MIF_FILE ../memory/piano2.mif
set_global_assignment -name SEARCH_PATH ..
set_global_assignment -name SEARCH_PATH ../memory

# ---- SDC (assignment2.sdc, Jason): the video side needs only these ----
#   create_clock -name CLOCK_50 -period 20.000 [get_ports CLOCK_50]
#   derive_pll_clocks                       ;# video_pll 25 MHz (and the audio PLLs)
#   derive_clock_uncertainty
#   set_clock_groups -asynchronous -group [get_clocks CLOCK_50] -group [get_clocks {*video_pll*}] ...
#   (CLOCK_50 <-> 25 MHz meet only in cdc_latch, the picture ROMs' two read ports and the two
#    dual-clock debug RAMs inside video_subsystem.sv; the switches go through synchroniser.v)
